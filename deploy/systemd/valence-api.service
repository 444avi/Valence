# /etc/systemd/system/valence-api.service
# Always-on FastAPI job runner. Runs the test suite before starting (a fee-model
# regression fails silently and costs money, so it must gate the boot: plan
# guardrails). Fetches the Anthropic key from SSM into a 0600 EnvironmentFile via
# ExecStartPre so no plaintext .env lives on the box.
[Unit]
Description=Valence arbitrage screener API
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=valence
Group=valence
WorkingDirectory=/opt/valence
Environment=VALENCE_HOME=/data/valence
# Set VALENCE_ADMIN_ACCOUNT_ID in a host-specific systemd drop-in after
# resolving the owner's exact stable ID from Accounts. Never guess from email.
Environment=ARBORETUM_ACCOUNTS_URL=https://accounts.arboretuminvestments.net
Environment=ARBORETUM_ISSUER=https://accounts.arboretuminvestments.net
Environment=ARBORETUM_AUDIENCE=arboretum-tools
Environment=ARBORETUM_JWKS_URL=https://accounts.arboretuminvestments.net/.well-known/jwks.json
Environment=ARBORETUM_COOKIE_NAME=arb_session
Environment=ARBORETUM_ALLOWED_RETURN_HOSTS=valence.arboretuminvestments.net
Environment=ARBORETUM_RETURN_ORIGIN=https://valence.arboretuminvestments.net
# Optional cross-run cache TTL (days); belt-and-suspenders on the full-text hash.
Environment=VALENCE_CACHE_TTL_DAYS=60

# Regression gate: refuse to (re)start on a failing suite. See plan section 10.
ExecStartPre=/opt/valence/.venv/bin/python -m pytest tests/ -q

# Materialize the secret from SSM Parameter Store into a private EnvironmentFile.
# The leading '-' makes the file optional at load time: systemd resolves
# EnvironmentFile before ExecStartPre runs, so on the first start the file does
# not exist yet. It is re-read for the ExecStart command after fetch-secret.sh
# has written it, so ExecStart still gets ANTHROPIC_API_KEY.
ExecStartPre=/opt/valence/deploy/scripts/fetch-secret.sh
EnvironmentFile=-/run/valence/env

ExecStart=/opt/valence/.venv/bin/uvicorn web.app:app --host 127.0.0.1 --port 8082

Restart=always
RestartSec=3

# Hardening: the box is a screener with no execution credentials (plan section 10).
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/data/valence /run/valence
RuntimeDirectory=valence
RuntimeDirectoryMode=0750

[Install]
WantedBy=multi-user.target

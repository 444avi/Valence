# /etc/systemd/system/cloudflared.service
# Named Cloudflare Tunnel. Dials OUTBOUND to Cloudflare, so the EC2 security
# group needs zero inbound rules and there is no ALB, no public IP path, no
# exposed SSH. This outbound-only posture is a transport security invariant,
# not an authentication mechanism. Valence trusts only the signed arb_session
# cookie issued by Arboretum Accounts. Do not add an inbound rule.
[Unit]
Description=Cloudflare Tunnel for Valence
After=network-online.target
Wants=network-online.target

[Service]
User=cloudflared
Group=cloudflared
# Credentials + ingress live in /etc/cloudflared/config.yml (see the example).
ExecStart=/usr/local/bin/cloudflared --no-autoupdate --config /etc/cloudflared/config.yml tunnel run
Restart=always
RestartSec=5
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
